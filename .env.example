# Environment Configuration
# =========================
# Copy this file to .env.local for local development.
# DO NOT commit .env.local to version control.

# ── SEARCH INDEXING CONTROL (CRITICAL) ─────────────────────────────────────────
#
# Search engine indexing is STRICTLY BLOCKED by default across all environments
# (local development, preview branches, and staging deployments).
#
# To permit search indexing on the PRODUCTION domain, ALL THREE conditions must be met:
#   1. ALLOW_SEARCH_INDEXING=true
#   2. VERCEL_ENV=production (set automatically by Vercel on production branch)
#   3. Request hostname is strictly 'www.entirefm.com'
#
# PRODUCTION ENVIRONMENT ONLY:
# Set the following variables in Vercel Project Settings > Environment Variables
# with Environment scope checked for "Production" ONLY:
#
ALLOW_SEARCH_INDEXING=true
NEXT_PUBLIC_SITE_URL=https://www.entirefm.com

# PREVIEW & DEVELOPMENT ENVIRONMENTS:
# Do NOT set ALLOW_SEARCH_INDEXING on Preview or Development environments.
# Staging/preview aliases (e.g. entirefmagv002.vercel.app) will always receive
# noindex, nofollow protection.

# ── DATABASE & SUPABASE STORAGE ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...

# ── LEAD PIPELINE DESTINATIONS (PRODUCTION ONLY) ──────────────────────────────
# Optional: Set at least one destination to receive enquiry form submissions:
# RESEND_API_KEY=re_...
# LEAD_WEBHOOK_URL=https://...
# LEAD_DELIVERY_EMAIL=enquiries@entirefm.com

# ── AI CONTROL PLANE & GOVERNED MODEL INTEGRATION ────────────────────────────
# Server-side model credential for CEO Command & AI Agent execution.
# If omitted, the platform operates in full deterministic FALLBACK mode.
# GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=

# ── AUTHENTICATION (REQUIRED FOR CORRECT AUTH FLOW) ───────────────────────────
#
# SITE_URL: The canonical public URL of this deployment.
#   - Production:  https://www.entirefm.com
#   - Preview:     https://<project>-<hash>.vercel.app  (set per deployment)
#   - Development: http://localhost:3000
# This is used as the base for Supabase auth redirectTo URLs (email confirmation,
# password recovery). Must match a URL whitelisted in:
#   Supabase Dashboard → Authentication → URL Configuration → Redirect URLs
# See: docs/SUPABASE_URL_CONFIG.md
SITE_URL=https://www.entirefm.com

# AUTH_HMAC_SECRET: Secret key for signing one-time recovery cookies.
#   Generate with: openssl rand -hex 32
#   Must be at least 32 characters. Keep this private — never commit to git.
#   See: docs/SUPABASE_URL_CONFIG.md
AUTH_HMAC_SECRET=change-me-generate-with-openssl-rand-hex-32
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── THE LOBBY DAILY & NEWSLETTER PUBLISHING ENGINE ────────────────────────────
# CRON_SECRET: Bearer token for authenticating Vercel cron triggers (04:30, 05:00, 06:45)
CRON_SECRET=generate-random-secret-for-cron-bearer-auth
# RESEND_API_KEY: Resend API key for transactional and newsletter dispatch
# RESEND_API_KEY=re_123456789
# RESEND_WEBHOOK_SECRET: Secret for verifying Resend bounce/complaint webhooks
# RESEND_WEBHOOK_SECRET=


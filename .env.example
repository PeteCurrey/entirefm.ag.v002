# Environment Configuration
# =========================
# Copy this file to .env.local and set values for your environment.
# DO NOT commit .env.local to version control.

# ── INDEXING CONTROL ──────────────────────────────────────────────────────────
#
# CRITICAL: Search engine indexing is BLOCKED by default.
# Setting NEXT_PUBLIC_SITE_URL enables production indexing.
# If this is NOT set, robots.txt will disallow all crawlers.
#
# Only set this on the production deployment.
# NEXT_PUBLIC_SITE_URL=https://entirefm.com

# ── NODE ENVIRONMENT ──────────────────────────────────────────────────────────
# Automatically set by Next.js — do not override unless you know what you're doing.
# NODE_ENV=development

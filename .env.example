# Environment Configuration
# =========================
# Copy this file to .env.local for local development.
# DO NOT commit .env.local to version control.

# ── SEARCH INDEXING CONTROL (CRITICAL) ─────────────────────────────────────────
#
# Search engine indexing is STRICTLY BLOCKED by default across all environments
# (local development, preview branches, and staging deployments).
#
# To permit search indexing on the PRODUCTION domain, ALL THREE conditions must be met:
#   1. ALLOW_SEARCH_INDEXING=true
#   2. VERCEL_ENV=production (set automatically by Vercel on production branch)
#   3. Request hostname is strictly 'www.entirefm.com'
#
# PRODUCTION ENVIRONMENT ONLY:
# Set the following variables in Vercel Project Settings > Environment Variables
# with Environment scope checked for "Production" ONLY:
#
ALLOW_SEARCH_INDEXING=true
NEXT_PUBLIC_SITE_URL=https://www.entirefm.com

# PREVIEW & DEVELOPMENT ENVIRONMENTS:
# Do NOT set ALLOW_SEARCH_INDEXING on Preview or Development environments.
# Staging/preview aliases (e.g. entirefmagv002.vercel.app) will always receive
# noindex, nofollow protection.

# ── DATABASE & SUPABASE STORAGE ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...

# ── LEAD PIPELINE DESTINATIONS (PRODUCTION ONLY) ──────────────────────────────
# Optional: Set at least one destination to receive enquiry form submissions:
# RESEND_API_KEY=re_...
# LEAD_WEBHOOK_URL=https://...
# LEAD_DELIVERY_EMAIL=enquiries@entirefm.com

# ── GOOGLE ANALYTICS 4 & SEARCH CONSOLE INTEGRATION ────────────────────────────
# Used by /admin/analytics for verified traffic, engagement, and keyword rankings.
GOOGLE_ANALYTICS_PROPERTY_ID=
SEARCH_CONSOLE_SITE_URL=https://www.entirefm.com
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

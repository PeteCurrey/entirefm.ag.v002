{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "NODE_OPTIONS='--max-old-space-size=8192' npm run build",
  "crons": [
    {
      "path": "/api/cron/lobby-daily/harvest",
      "schedule": "30 4 * * 1-5"
    },
    {
      "path": "/api/cron/lobby-daily/draft",
      "schedule": "0 5 * * 1-5"
    },
    {
      "path": "/api/cron/lobby-daily/dispatch",
      "schedule": "45 6 * * 1-5"
    },
    {
      "path": "/api/cron/intelligence/regulatory",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/intelligence/tenders",
      "schedule": "20 */12 * * *"
    },
    {
      "path": "/api/cron/intelligence/company-watch",
      "schedule": "40 4 * * *"
    },
    {
      "path": "/api/cron/chasing/sweep",
      "schedule": "*/15 6-19 * * 1-5"
    },
    {
      "path": "/api/cron/ppm/generate",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/ppm/check-missed",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/analytics/monthly-estate-report",
      "schedule": "0 7 1 * *"
    }
  ]
}

